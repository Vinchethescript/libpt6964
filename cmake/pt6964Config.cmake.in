@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Capture the state of the option when the library was installed
set(PT6964_ENABLE_PIGPIO @ENABLE_PIGPIO@)

# Only search for the dependency if the option was ON
if(PT6964_ENABLE_PIGPIO)
    find_dependency(pigpio)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pt6964_targets.cmake")